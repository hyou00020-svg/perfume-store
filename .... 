<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>متجر العطور الفاخرة</title>
  <style>
    @keyframes gradientBG {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    :root {
      --primary-gold: #d4af37;
      --card-bg: rgba(30, 41, 59, 0.75);
      --card-border: rgba(212, 175, 55, 0.3);
      --text-main: #f8fafc;
      --text-muted: #cbd5e1;
      --danger-color: #ef4444;
      --whatsapp-color: #25d366;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    }

    body {
      background: linear-gradient(-45deg, #0f172a, #1e1b4b, #2e1065, #0f172a);
      background-size: 400% 400%;
      animation: gradientBG 12s ease infinite;
      color: var(--text-main);
      min-height: 100vh;
      padding: 16px;
      max-width: 500px;
      margin: 0 auto;
    }

    .page { display: none; }
    .active { display: block; }

    header {
      text-align: center;
      margin-bottom: 20px;
    }

    header h1 {
      font-size: 1.5rem;
      color: var(--primary-gold);
    }

    header p {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .card {
      background: var(--card-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 18px;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
      margin-bottom: 16px;
    }

    .form-group {
      margin-bottom: 14px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--primary-gold);
    }

    input[type="text"] {
      width: 100%;
      padding: 12px;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(212, 175, 55, 0.3);
      border-radius: 10px;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
    }

    input:focus {
      border-color: var(--primary-gold);
    }

    /* أزرار اختيار الأحجام */
    .size-btn-group {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 6px;
    }

    .size-chip {
      padding: 8px 14px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid var(--card-border);
      color: #fff;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.85rem;
      transition: all 0.2s ease;
      user-select: none;
    }

    .size-chip.active {
      background: var(--primary-gold);
      color: #000;
      font-weight: bold;
      border-color: var(--primary-gold);
      box-shadow: 0 0 10px rgba(212, 175, 55, 0.4);
    }

    .file-upload-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px;
      background: rgba(212, 175, 55, 0.1);
      color: var(--primary-gold);
      border: 2px dashed var(--primary-gold);
      border-radius: 10px;
      cursor: pointer;
      font-weight: 600;
      text-align: center;
    }

    input[type="file"] { display: none; }

    #imagePreview {
      width: 100%;
      max-height: 160px;
      object-fit: cover;
      margin-top: 10px;
      border-radius: 10px;
      border: 1px solid var(--primary-gold);
      display: none;
    }

    .btn {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: bold;
      cursor: pointer;
    }

    .btn-gold {
      background: linear-gradient(135deg, #d4af37, #b8962e);
      color: #000;
    }

    .btn-danger {
      background-color: var(--danger-color);
      color: white;
      margin-bottom: 16px;
    }

    .btn-whatsapp {
      background-color: var(--whatsapp-color);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      margin-top: 12px;
      padding: 12px;
      border-radius: 10px;
      font-weight: bold;
    }

    .perfume-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .perfume-card {
      background: var(--card-bg);
      backdrop-filter: blur(8px);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      transition: transform 0.2s;
    }

    .perfume-card:active {
      transform: scale(0.97);
    }

    .perfume-card img {
      width: 100%;
      height: 130px;
      object-fit: cover;
    }

    .perfume-info {
      padding: 10px;
      text-align: center;
    }

    .perfume-info h3 {
      font-size: 0.9rem;
      color: #fff;
      margin-bottom: 4px;
    }

    .perfume-price {
      color: var(--primary-gold);
      font-weight: bold;
      font-size: 0.85rem;
    }

    .btn-delete {
      background-color: rgba(239, 68, 68, 0.2);
      color: #fca5a5;
      border: 1px solid var(--danger-color);
      padding: 6px;
      border-radius: 6px;
      font-size: 0.75rem;
      cursor: pointer;
      margin-top: 8px;
      width: 100%;
    }

    /* Modal التفاصيل */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.85);
      backdrop-filter: blur(6px);
      z-index: 1000;
      justify-content: center;
      align-items: center;
      padding: 16px;
    }

    .modal-content {
      background: #1e293b;
      border: 1px solid var(--primary-gold);
      border-radius: 16px;
      width: 100%;
      max-width: 400px;
      padding: 20px;
      position: relative;
    }

    .close-modal {
      position: absolute;
      top: 10px;
      left: 14px;
      font-size: 1.6rem;
      color: var(--text-muted);
      cursor: pointer;
    }

    .pyramid-box {
      background: rgba(15, 23, 42, 0.6);
      border-radius: 10px;
      padding: 12px;
      margin: 12px 0;
      border-right: 3px solid var(--primary-gold);
    }

    .pyramid-item {
      font-size: 0.85rem;
      margin-bottom: 6px;
    }

    .pyramid-item span {
      color: var(--primary-gold);
      font-weight: bold;
    }

    .empty-msg {
      grid-column: 1 / -1;
      text-align: center;
      color: var(--text-muted);
      padding: 20px 0;
    }
  </style>
</head>
<body>

  <!-- ================= 1. الصفحة الرئيسية ================= -->
  <div id="userPage" class="page active">
    <header>
      <h1>✨ متجر العطور الفاخرة ✨</h1>
      <p>اختر عطرك المفضل لمعرفة تفاصيله والطلب</p>
    </header>

    <div class="card">
      <input type="text" id="searchInput" placeholder="🔍 ابحث عن اسم العطر..." oninput="handleSearch()">
    </div>

    <div id="perfumeContainer" class="perfume-grid">
      <!-- شبكة العطور -->
    </div>
  </div>

  <!-- ================= 2. لوحة التحكم (المدير) ================= -->
  <div id="adminPage" class="page">
    <header>
      <h1>⚙️ لوحة التحكم</h1>
    </header>

    <button class="btn btn-danger" onclick="exitAdmin()">⬅️ الخروج من لوحة التحكم</button>

    <div class="card">
      <h2 style="color: var(--primary-gold); font-size: 1.1rem; margin-bottom: 14px;">إضافة عطر جديد</h2>
      
      <div class="form-group">
        <label>اسم العطر:</label>
        <input type="text" id="perfumeName" placeholder="مثال: عطر العود الملكي">
      </div>

      <div class="form-group">
        <label>السعر:</label>
        <input type="text" id="perfumePrice" placeholder="مثال: $50 أو 75,000 د.ع">
      </div>

      <!-- قسم تحديد الأحجام في المدير -->
      <div class="form-group">
        <label>الأحجام المتاحة (انقر للتحديد):</label>
        <div class="size-btn-group" id="adminSizeGroup">
          <div class="size-chip" onclick="toggleAdminSize(this, '30 مل')">30 مل</div>
          <div class="size-chip" onclick="toggleAdminSize(this, '50 مل')">50 مل</div>
          <div class="size-chip" onclick="toggleAdminSize(this, '75 مل')">75 مل</div>
          <div class="size-chip" onclick="toggleAdminSize(this, '100 مل')">100 مل</div>
          <div class="size-chip" onclick="toggleAdminSize(this, '200 مل')">200 مل</div>
        </div>
      </div>

      <div class="form-group">
        <label>قمة العطر (Top Notes):</label>
        <input type="text" id="topNotes" placeholder="مثال: البرغموت، اللافندر">
      </div>

      <div class="form-group">
        <label>قلب العطر (Heart Notes):</label>
        <input type="text" id="heartNotes" placeholder="مثال: الياسمين، الورد الجوري">
      </div>

      <div class="form-group">
        <label>قاعدة العطر (Base Notes):</label>
        <input type="text" id="baseNotes" placeholder="مثال: العود، العنبر، الصندل">
      </div>

      <div class="form-group">
        <label>صورة العطر:</label>
        <label for="perfumeImageInput" class="file-upload-btn">📷 اختيار صورة من الهاتف</label>
        <input type="file" id="perfumeImageInput" accept="image/*" onchange="previewImage(event)">
        <img id="imagePreview" alt="معاينة الصورة">
      </div>

      <button class="btn btn-gold" onclick="savePerfume()">✨ حفظ وإضافة العطر</button>
    </div>

    <div class="card">
      <h2 style="color: var(--primary-gold); font-size: 1.1rem; margin-bottom: 14px;">إدارة العطور الحالية</h2>
      <div id="adminPerfumeList" class="perfume-grid"></div>
    </div>
  </div>

  <!-- ================= 3. النافذة المنبثقة للتفاصيل والطلب ================= -->
  <div id="detailModal" class="modal">
    <div class="modal-content">
      <span class="close-modal" onclick="closeModal()">&times;</span>
      <img id="modalImg" src="" alt="" style="width:100%; height:160px; object-fit:cover; border-radius:10px; margin-bottom:12px;">
      <h2 id="modalTitle" style="color:var(--primary-gold); font-size:1.2rem;"></h2>
      <p id="modalPrice" style="color:#fff; font-weight:bold; margin-top:4px; font-size:1rem;"></p>

      <!-- أزرار الأحجام في صفحة العطر -->
      <div id="modalSizesContainer" style="margin-top: 12px;">
        <label>📏 اختر الحجم المطلوب:</label>
        <div class="size-btn-group" id="modalSizesGroup"></div>
      </div>
      
      <div class="pyramid-box">
        <h4 style="color:var(--primary-gold); margin-bottom:6px;">🌸 الهرم العطري:</h4>
        <div class="pyramid-item"><span>قمة العطر:</span> <span id="modalTop" style="color:#fff;"></span></div>
        <div class="pyramid-item"><span>قلب العطر:</span> <span id="modalHeart" style="color:#fff;"></span></div>
        <div class="pyramid-item"><span>قاعدة العطر:</span> <span id="modalBase" style="color:#fff;"></span></div>
      </div>

      <a id="modalWhatsapp" href="#" target="_blank" class="btn-whatsapp">
        💬 طلب العطر عبر الواتساب
      </a>
    </div>
  </div>

  <script>
    const ADMIN_PASSPHRASE = "افتح لوحة التحكم"; 
    const WHATSAPP_PHONE = "9640000000000"; // رقم الواتساب الخاص بك

    let currentImageData = "";
    let selectedAdminSizes = [];
    let currentSelectedSize = "";
    let activePerfume = null;

    document.addEventListener("DOMContentLoaded", () => {
      renderPerfumes();
    });

    function handleSearch() {
      const query = document.getElementById("searchInput").value.trim();
      if (query === ADMIN_PASSPHRASE) {
        document.getElementById("searchInput").value = "";
        showAdminPage();
        return;
      }
      renderPerfumes(query);
    }

    function showAdminPage() {
      document.getElementById("userPage").classList.remove("active");
      document.getElementById("adminPage").classList.add("active");
      renderAdminPerfumes();
    }

    function exitAdmin() {
      document.getElementById("adminPage").classList.remove("active");
      document.getElementById("userPage").classList.add("active");
      renderPerfumes();
    }

    // تحديد الأحجام في صفحة المدير
    function toggleAdminSize(element, size) {
      element.classList.toggle("active");
      if (selectedAdminSizes.includes(size)) {
        selectedAdminSizes = selectedAdminSizes.filter(s => s !== size);
      } else {
        selectedAdminSizes.push(size);
      }
    }

    function previewImage(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          currentImageData = e.target.result;
          const preview = document.getElementById("imagePreview");
          preview.src = currentImageData;
          preview.style.display = "block";
        };
        reader.readAsDataURL(file);
      }
    }

    function getPerfumes() {
      const perfumes = localStorage.getItem("my_luxury_perfumes");
      return perfumes ? JSON.parse(perfumes) : [];
    }

    function savePerfume() {
      const name = document.getElementById("perfumeName").value.trim();
      const price = document.getElementById("perfumePrice").value.trim();
      const top = document.getElementById("topNotes").value.trim() || "غير محدد";
      const heart = document.getElementById("heartNotes").value.trim() || "غير محدد";
      const base = document.getElementById("baseNotes").value.trim() || "غير محدد";

      if (!name || !price) {
        alert("يرجى إدخال اسم العطر والسعر.");
        return;
      }

      if (!currentImageData) {
        alert("يرجى اختيار صورة للعطر من الهاتف.");
        return;
      }

      const perfumes = getPerfumes();
      perfumes.push({
        id: Date.now(),
        name,
        price,
        sizes: [...selectedAdminSizes], // حفظ الأحجام المحددة
        top,
        heart,
        base,
        image: currentImageData
      });

      localStorage.setItem("my_luxury_perfumes", JSON.stringify(perfumes));
      alert("تمت إضافة العطر بنجاح!");

      // تفريغ المدخلات
      document.getElementById("perfumeName").value = "";
      document.getElementById("perfumePrice").value = "";
      document.getElementById("topNotes").value = "";
      document.getElementById("heartNotes").value = "";
      document.getElementById("baseNotes").value = "";
      document.getElementById("perfumeImageInput").value = "";
      document.getElementById("imagePreview").style.display = "none";
      
      // إعادة تعيين أزرار الأحجام في لوحة التحكم
      selectedAdminSizes = [];
      document.querySelectorAll("#adminSizeGroup .size-chip").forEach(chip => chip.classList.remove("active"));
      currentImageData = "";

      renderAdminPerfumes();
    }

    function deletePerfume(id) {
      if (confirm("هل أنت تأكد من حذف هذا العطر؟")) {
        let perfumes = getPerfumes();
        perfumes = perfumes.filter(p => p.id !== id);
        localStorage.setItem("my_luxury_perfumes", JSON.stringify(perfumes));
        renderAdminPerfumes();
      }
    }

    function renderPerfumes(filterText = "") {
      const container = document.getElementById("perfumeContainer");
      const perfumes = getPerfumes();

      const filtered = perfumes.filter(p => 
        p.name.toLowerCase().includes(filterText.toLowerCase())
      );

      if (filtered.length === 0) {
        container.innerHTML = `<p class="empty-msg">لا توجد عطور متوفرة حالياً.</p>`;
        return;
      }

      container.innerHTML = filtered.map(p => `
        <div class="perfume-card" onclick="openModal(${p.id})">
          <img src="${p.image}" alt="${p.name}">
          <div class="perfume-info">
            <h3>${p.name}</h3>
            <div class="perfume-price">${p.price}</div>
          </div>
        </div>
      `).join('');
    }

    function renderAdminPerfumes() {
      const container = document.getElementById("adminPerfumeList");
      const perfumes = getPerfumes();

      if (perfumes.length === 0) {
        container.innerHTML = `<p class="empty-msg">لا توجد عطور مضافة بعد.</p>`;
        return;
      }

      container.innerHTML = perfumes.map(p => `
        <div class="perfume-card" style="cursor:default;">
          <img src="${p.image}" alt="${p.name}">
          <div class="perfume-info">
            <h3>${p.name}</h3>
            <div class="perfume-price">${p.price}</div>
            <button class="btn-delete" onclick="deletePerfume(${p.id})">حذف</button>
          </div>
        </div>
      `).join('');
    }

    // فتح تفاصيل العطر وتوليد أزرار الأحجام
    function openModal(id) {
      const perfumes = getPerfumes();
      activePerfume = perfumes.find(p => p.id === id);
      if (!activePerfume) return;

      document.getElementById("modalImg").src = activePerfume.image;
      document.getElementById("modalTitle").innerText = activePerfume.name;
      document.getElementById("modalPrice").innerText = `السعر: ${activePerfume.price}`;
      document.getElementById("modalTop").innerText = activePerfume.top;
      document.getElementById("modalHeart").innerText = activePerfume.heart;
      document.getElementById("modalBase").innerText = activePerfume.base;

      // عرض أزرار الأحجام المتاحة للعطر
      const sizesContainer = document.getElementById("modalSizesGroup");
      const sizesWrapper = document.getElementById("modalSizesContainer");

      if (activePerfume.sizes && activePerfume.sizes.length > 0) {
        sizesWrapper.style.display = "block";
        currentSelectedSize = activePerfume.sizes[0]; // تحديد أول حجم افتراضياً
        sizesContainer.innerHTML = activePerfume.sizes.map((s, idx) => `
          <div class="size-chip ${idx === 0 ? 'active' : ''}" onclick="selectModalSize(this, '${s}')">${s}</div>
        `).join('');
      } else {
        sizesWrapper.style.display = "none";
        currentSelectedSize = "";
      }

      updateWhatsappLink();
      document.getElementById("detailModal").style.display = "flex";
    }

    function selectModalSize(element, size) {
      document.querySelectorAll("#modalSizesGroup .size-chip").forEach(c => c.classList.remove("active"));
      element.classList.add("active");
      currentSelectedSize = size;
      updateWhatsappLink();
    }

    function updateWhatsappLink() {
      if (!activePerfume) return;
      let sizeInfo = currentSelectedSize ? ` בחجم: (${currentSelectedSize})` : "";
      const waMsg = encodeURIComponent(`مرحباً، أود طلب عطر: (${activePerfume.name})${sizeInfo} بسعر (${activePerfume.price})`);
      document.getElementById("modalWhatsapp").href = `https://wa.me/${WHATSAPP_PHONE}?text=${waMsg}`;
    }

    function closeModal() {
      document.getElementById("detailModal").style.display = "none";
    }
  </script>
</body>
</html>
